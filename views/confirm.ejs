<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Thank You</title>
        <link rel="icon" href="/images/favicon.png">
        <link rel="stylesheet" href="/styles.css">
    </head>
    <body>
      <%- include('partials/navigation') %>
      <h1>Thank You, <%= contact.first %>!</h1>
      <ul>
        <li>Name: <%= contact.first %> <%= contact.last %></li>
        <li>Job Title: <%= contact.job %></li>
        <li>Company: <%= contact.company %></li>
        <li>LinkedIn: <%= contact.linkedin %></li>
        <li>Email: <%= contact.email %></li>
        <li>How we met: <%= contact.meet === 'Other' ? contact.other : contact.meet %></li>
        <li>Message: <%= contact.message %></li>
        <li>Mailing list: <%= contact.mailing ? 'Yes' : 'No' %></li>
        <li>Email format: <%= contact.format %></li>
        <li>Submitted: <%= contact.timestamp.toLocaleString() %></li>
      </ul>
    </body>
</html>
